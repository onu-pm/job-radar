# Copy this file to .env and fill in the values. .env is never committed (see .gitignore).

# OpenRouter — openrouter.ai → Keys
OPENROUTER_API_KEY=

# Serper (Google results) — serper.dev → API key
SERPER_API_KEY=

# Supabase — Project Settings → API (URL + service_role key) and → Database (connection string)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Website password (you choose it)
SITE_PASSWORD=

# "Refresh now" button: a GitHub fine-grained token with Actions: read & write on onu-pm/job-radar
GITHUB_REPO=onu-pm/job-radar
GH_DISPATCH_TOKEN=
